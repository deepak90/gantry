# Pin the @bryntum scope to the public registry so every machine resolves the
# same public trial packages.
@bryntum:registry=https://registry.npmjs.org/
# The Bryntum React wrapper imports @bryntum/gantt (aliased to gantt-trial) without
# declaring it as a peer; hoist the scope so pnpm's isolated layout can resolve it.
public-hoist-pattern[]=@bryntum/*
