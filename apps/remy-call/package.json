{
  "name": "@collab/remy-call",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Remy on a LiveKit call: hears each caller on their own track, says what the host's tab hands it, and keeps to turn-taking rules",
  "scripts": {
    "start": "node --env-file-if-exists=../../.env.local src/main.ts dev",
    "start:prod": "node --env-file-if-exists=../../.env.local src/main.ts start",
    "lockfile": "node scripts/lockfile.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "node --env-file-if-exists=../../.env.local test/smoke/run.ts"
  },
  "dependencies": {
    "@livekit/agents": "1.9.3",
    "@livekit/agents-plugin-openai": "1.9.3",
    "@livekit/agents-plugin-silero": "1.9.3",
    "@livekit/rtc-node": "1.1.0",
    "livekit-server-sdk": "2.19.1",
    "openai": "6.49.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
