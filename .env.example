# Template for the repo-root .env.local (gitignored). Vite, the scripts, the Edge Functions, the
# assistant service and Remy's call worker all read that one file. Copy, then fill the empty values.

# ---- Supabase (local stack: `supabase start`, values from `supabase status -o env`) ----
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# ---- Anthropic (the assistant service, apps/agent: `pnpm agent:dev`) ----
ANTHROPIC_API_KEY=
# live = Claude; mock = scripted stand-in (no key, no cost); replay = the last recorded live run.
# Empty: live when ANTHROPIC_API_KEY is set, else mock.
AGENT_MODE=
# Optional: watch only these projects (comma-separated ids); empty = every project
AGENT_PROJECT_IDS=
# Optional model overrides (defaults: claude-opus-5-5 to find issues, claude-sonnet-5-5 for replies)
AGENT_MODEL_ANALYSIS=
AGENT_MODEL_CHAT=
# Optional: names a new thread from its first message (default: the chat model; live mode only)
AGENT_MODEL_TITLE=
# Optional: off (default) = the assistant answers when asked; issues = it also raises a problem it notices
# when both people are in the plan or the plan changes
AGENT_PROACTIVE=
# Optional, with AGENT_PROACTIVE=issues: wait before the opening once both people are present (default 2000)
AGENT_OPENING_DELAY_MS=
# Optional: the model the place-snippet Edge Function asks where a dropped library piece goes (default claude-opus-5-5)
PLACEMENT_MODEL=
# Optional: the model that writes the simulated teammates' notes in `pnpm crowd` (default claude-opus-5-5)
CROWD_MODEL=

# ---- PayPal sandbox (Developer Dashboard > Apps & Credentials, a Merchant app; steps in docs/SETUP.md section 3) ----
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# live = call the PayPal sandbox; mock = deterministic in-process responses for tests
PAYPAL_MODE=mock
# A sandbox PERSONAL account you own; payouts to any other address stay UNCLAIMED. Seeded into the supplier booking by `pnpm db:reset`.
PAYPAL_SANDBOX_PAYEE_EMAIL=
# The tenant's own sandbox account, which Harbor's invoices bill. Without it they go to PAYPAL_SANDBOX_PAYEE_EMAIL.
PAYPAL_SANDBOX_TENANT_EMAIL=
# The hosted demo's functions only: 1 = every invoice bills PAYPAL_SANDBOX_TENANT_EMAIL, whatever the project says.
GANTRY_HOSTED=
# Each firm's own sandbox account: PAYPAL_SANDBOX_<first word of its name>_EMAIL. A live payment is refused without one.
PAYPAL_SANDBOX_GRANITE_EMAIL=
PAYPAL_SANDBOX_PINECREST_EMAIL=
# The business on PayPal invoices, as the payer reads it (optional; else the PayPal account's own name).
PAYPAL_INVOICER_NAME=Aldermere Construction
# Optional: only when the paypal-webhook function has a public URL (polling is the source of truth)
PAYPAL_WEBHOOK_ID=
# Optional, dev server: skip = PayPal's window and approval are real but nothing is captured (a dry run)
PAYPAL_CAPTURE=
# Optional, dev server with PAYPAL_MODE=mock: how long a mocked crew payout takes to settle, in ms (default 2500)
PAYPAL_MOCK_SETTLE_MS=

# ---- Demo ----
# The hosted site: 1 = landing page at /, the app at /app with a private copy of Harbor per visitor, analytics.
# Set it in Vercel's Production environment (`pnpm deploy:site` builds with it); leave it empty here for local work.
VITE_GANTRY_HOSTED=
# Hosted site only: Cloudflare Turnstile's public site key, for the check before a visitor's anonymous sign-in
VITE_TURNSTILE_SITE_KEY=
# Optional: the plan's today as YYYY-MM-DD, for the web app (VITE_PLAN_DATE) and the assistant service
# (GANTRY_PLAN_DATE). The hosted site runs on the film's day, 2026-11-10; empty here = the real clock.
VITE_PLAN_DATE=
GANTRY_PLAN_DATE=

# ---- The call with Remy (`livekit-server --dev`, `pnpm remy:call`, `pnpm dev`, then `?call` in the address) ----
# The LiveKit server; `livekit-server --dev` listens on ws://127.0.0.1:7880 with key devkey and secret secret
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional locally: the address the browser uses for LiveKit, when it differs from LIVEKIT_URL.
# The hosted site: the call server's address.
VITE_LIVEKIT_URL=
# OpenAI: Remy's ears on the call and her voice by default
OPENAI_API_KEY=
# Optional: an ElevenLabs voice for Remy instead of OpenAI's. Set both or neither.
ELEVEN_LABS_API_KEY=
ELEVEN_LABS_VOICE_REMY_KEY=
# Optional: the ElevenLabs model (default eleven_flash_v2_5)
REMY_ELEVEN_TTS_MODEL=
# Optional: the transcription model (default gpt-live-transcribe)
REMY_STT_MODEL=
# Optional: extra words for the transcriber, comma-separated (names, trade words)
REMY_STT_HINTS=
# Optional: off = no filler ("Let me look.") while a slow answer is on its way
REMY_FILLERS=
# Optional: where checked fillers are kept between calls (default: the system's temp folder)
REMY_FILLER_CACHE=
# Optional: off = don't re-render an OpenAI line that comes out too slow (REMY_PACE_CHECK) or creaky (REMY_FRY_CHECK)
REMY_PACE_CHECK=
REMY_FRY_CHECK=
# Optional: the name LiveKit dispatches the worker by (default remy; tests change it)
REMY_AGENT_NAME=
