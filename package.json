{
  "name": "gantry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gantry: a construction schedule a general contractor's team plans in, talks through with an AI assistant, and pays trade partners from through PayPal",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.18 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @collab/web dev",
    "agent:dev": "pnpm --filter @collab/agent dev",
    "functions:serve": "supabase functions serve --env-file .env.local",
    "crowd": "node scripts/realtime-limits.ts && node --env-file-if-exists=.env.local scripts/crowd.ts",
    "crowd:harbor": "node scripts/realtime-limits.ts && node --env-file-if-exists=.env.local scripts/crowd.ts --project 00000000-0000-4000-8000-000000000002 --areas 'Site and foundations;Structure' --every 20-35",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p tests/e2e && tsc -p tests/clips && tsc -p api",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:db": "supabase test db",
    "test:e2e": "playwright test",
    "clips": "playwright test -c playwright.clips.config.ts",
    "db:start": "supabase start",
    "db:reset": "node --env-file-if-exists=.env.local scripts/gen-seed-local.ts && supabase db reset && node --env-file-if-exists=.env.local scripts/seed-documents.ts",
    "demo:reset": "node --env-file-if-exists=.env.local scripts/demo-reset.ts",
    "demo:reset:force": "pnpm demo:reset --force",
    "seed:snapshot": "node scripts/gen-seed-snapshot.ts",
    "remy:call": "pnpm --filter @collab/remy-call start",
    "remy:call:prod": "pnpm --filter @collab/remy-call start:prod",
    "deploy:site": "node scripts/deploy-site.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "livekit-server-sdk": "2.19.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.132.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "pdf-lib": "1.17.1",
    "typescript": "5.9.3",
    "zod": "4.6.7"
  },
  "pnpm": {
    "packageExtensions": {
      "@paypal/paypal-server-sdk@1": {
        "dependencies": {
          "tslib": "^2.8.1"
        }
      }
    }
  }
}
